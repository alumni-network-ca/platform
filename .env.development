# Settings for `next dev`, committed so every checkout and worktree runs without setup.
# The app uses the shared cloud dev database: the Supabase project alumni-network-staging (ca-central-1), which
# every merge into `dev` migrates. Tests never use it: they run on the local Docker stack (`supabase start`).
# The publishable key is public by design (every browser receives it) and RLS guards the data. Never put a secret
# key here. Override any value in .env.local (git-ignored), for example to run the app on the local stack.
NEXT_PUBLIC_SUPABASE_URL=https://xrcpwgsrecmgxxencogr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7u9lJaMzDjVwF1zSZjL-XA_RuNCOd0n
ROOT_DOMAIN=localhost
NEXT_PUBLIC_SITE_URL=http://herzliah.localhost:3000
