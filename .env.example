# Every variable the app reads. `npm run dev` already runs on the cloud dev database through the committed
# .env.development. Copy this file to .env.local (git-ignored, overrides .env.development) only to run the app on
# the LOCAL Supabase stack, for example to try a migration before it is merged; the values below are for that.
# Staging and production values live only in the Vercel / Supabase dashboards. Never commit real secrets.
# The app reads these only through config/env/ (ADR 0017); each section below matches one file there.

# --- Public: config/env/public.ts. Inlined into the browser bundle at build time ---------------------------------
# Supabase API. Local values come from `supabase status -o env` (API_URL / PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-local-publishable-key-from-supabase-status

# --- Server: config/env/server.ts. Not secret, read at request time ----------------------------------------------
# The domain schools are subdomains of (ADR 0001): herzliah.<ROOT_DOMAIN>. The bare domain is the page for schools.
# Local: localhost (open http://herzliah.localhost:3000). Staging: staging.alumninetwork.ca. Production: alumninetwork.ca.
ROOT_DOMAIN=localhost
# Required. Sender domain: noreply@<EMAIL_FROM_DOMAIN> (DEC-12), verified in Resend (EML-02).
EMAIL_FROM_DOMAIN=alumninetwork.ca
# Vercel PR previews only (VERCEL_ENV=preview, set by Vercel): the school shown when no ?tenant=<slug> cookie is set.
PREVIEW_DEFAULT_SCHOOL=herzliah
# Set by Vercel (VERCEL_GIT_COMMIT_SHA): part of the school config cache key, so a deploy starts fresh. Leave unset locally.
# VERCEL_GIT_COMMIT_SHA=

# --- Secrets: config/env/secrets.ts. Server only, NEVER prefix with NEXT_PUBLIC_ ----------------------------------
# Supabase secret key: jobs, webhooks, invitations (FND-08).
SUPABASE_SECRET_KEY=
# Transactional email (EML-01, ADR 0007). Required: every environment sends through Resend, each with its own key.
# Missing, the send fails and the email stays in email_outbox for the cron sweeper to retry.
RESEND_API_KEY=
# Required. Shared secret for cron routes: /api/cron/email (EML-01), FRS-02.
CRON_SECRET=local-cron-secret

# --- Added by later issues (leave empty until then; each gets a getter in config/env/ when it lands) --------------
# Cloudflare Turnstile (FND-10). Local dev can use Cloudflare's documented test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sentry (FND-17).
SENTRY_DSN=

# --- Tooling only: read by scripts/, e2e/ and playwright.config.ts, never by the app. Usually set per command ----
# `npm run admin:bootstrap` on a hosted project: SUPABASE_URL with that project's SUPABASE_SECRET_KEY, on the command
# line (neither = the local stack). Scripts don't load this file.
# SUPABASE_URL=https://<ref>.supabase.co
# A separate local Supabase stack for this worktree (`supabase status --workdir`).
# SUPABASE_WORKDIR=
# Run the e2e tests against an already running server instead of starting one, and save sign-up screenshots.
# E2E_BASE_URL=
# E2E_SCREENSHOT_DIR=
# `npm run backlog:seed` falls back to `gh auth token` when unset.
# GITHUB_TOKEN=
