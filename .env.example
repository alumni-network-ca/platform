# Copy to .env.local for local development (.env.local is git-ignored and overrides .env).
# Values below are for the LOCAL Supabase stack. Staging and production values live only in the
# Vercel / Supabase dashboards (see docs/runbooks/secrets.md once FND-16 lands). Never commit real secrets.

# Supabase API. Local values come from `supabase status -o env` (API_URL / PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-local-publishable-key-from-supabase-status

# The domain schools are subdomains of (ADR 0001): herzliah.<ROOT_DOMAIN>. The bare domain is the page for schools.
# Local: localhost (open http://herzliah.localhost:3000). Staging: staging.alumninetwork.ca. Production: alumninetwork.ca.
ROOT_DOMAIN=localhost
# Vercel PR previews only (VERCEL_ENV=preview): the school shown when no ?tenant=<slug> cookie is set.
PREVIEW_DEFAULT_SCHOOL=herzliah

# Absolute base URL used in emails and redirects.
NEXT_PUBLIC_SITE_URL=http://herzliah.localhost:3000

# --- Added by later issues (leave empty until then) ---------------------------------------------
# Server-only Supabase secret key: jobs, webhooks, invitations. NEVER prefix with NEXT_PUBLIC_. (FND-08)
SUPABASE_SECRET_KEY=
# Transactional email (EML-01/02). Local development sends to Mailpit at http://127.0.0.1:54324.
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=mail.alumninetwork.ca
# Cloudflare Turnstile (FND-10). Local dev can use Cloudflare's documented test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared secret for cron routes (EML-01, FRS-02).
CRON_SECRET=
# Sentry (FND-17).
SENTRY_DSN=
